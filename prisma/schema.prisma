generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../dev.db"
}


enum PlayerStatus {
  ACTIVE
  INACTIVE
}

enum AdminStatus {
  ACTIVE
  INACTIVE
}

enum GameMode {
  RAPID
  BLITZ
  BULLET
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalType {
  REGISTRATION
  BIO_CHANGE
  USERNAME_CHANGE
  PROFILE_CHANGE
  PASSWORD_CHANGE
}

enum NotificationType {
  ANNOUNCEMENT
  APPROVAL
  REJECTION
  PAIRING
  RESULT
  RANKING
  CHAMPIONSHIP
  SYSTEM
}

enum ChampionshipType {
  TOURNAMENT
  BULLET
}

enum TournamentStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}


model Player {
  id       Int    @id @default(autoincrement())
  fullName String
  username String @unique
  passwordHash String?

  status PlayerStatus @default(ACTIVE)

  category String @default("")
  bio      String @default("")

  rapidRating  Int @default(0)
  blitzRating  Int @default(0)
  bulletRating Int @default(0)

  rapidGain  Int @default(0)
  blitzGain  Int @default(0)
  bulletGain Int @default(0)

  totalPoints Float @default(0)
  totalRounds Int   @default(0)

  currentChampionTitle String?
  championshipWins     Int @default(0)

  teamId Int?
  team Team? @relation("PlayerTeam",fields: [teamId],references: [id],onDelete: SetNull)
  
  captainOfTeam Team? @relation("TeamCaptain")


  whitePairings Pairing[] @relation("WhitePlayer")
  blackPairings Pairing[] @relation("BlackPlayer")

  whiteResults GameResult[] @relation("WhitePlayerResults")
  blackResults GameResult[] @relation("BlackPlayerResults")

  rankings PlayerRanking[]

  ratingGains RatingGain[]

  teamMemberships TeamMembership[]

  approvalRequests ApprovalRequest[]

  tournamentResults TournamentResult[]
  tournamentWon Tournament[] @relation("TournamentChampion")

  bulletChampionshipsWon BulletChampionship[] @relation("BulletChampion")
  notifications Notification[]

  bulletMemberships BulletChampionshipPlayer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([teamId])
  @@index([fullName])
}


model Team {
  id          Int    @id @default(autoincrement())
  name        String @unique
  description String @default("")

  captainId Int? @unique

  captain Player? @relation("TeamCaptain", fields:[captainId],references:[id],onDelete: SetNull)

  players Player[] @relation("PlayerTeam")

  totalPoints Int @default(0)

  rapidGain  Int @default(0)
  blitzGain  Int @default(0)
  bulletGain Int @default(0)

  memberships TeamMembership[]

  teamPairingsAsTeamA TeamPairing[] @relation("TeamA")
  teamPairingsAsTeamB TeamPairing[] @relation("TeamB")

  rankings TeamRanking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([captainId])
}


model TeamMembership {
  id Int @id @default(autoincrement())

  teamId   Int
  playerId Int

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  status MembershipStatus @default(ACTIVE)

  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  @@unique([teamId, playerId])
  @@index([teamId])
  @@index([playerId])
  @@index([status])
}


model Pairing {
  id Int @id @default(autoincrement())

  category String
  round    Int
  mode     GameMode

  whitePlayerId Int
  blackPlayerId Int

  whitePlayer Player @relation("WhitePlayer",fields: [whitePlayerId],references: [id],onDelete: Cascade)

  blackPlayer Player @relation("BlackPlayer",fields: [blackPlayerId],references: [id],onDelete: Cascade)

  availableAt DateTime

  createdAt DateTime @default(now())

  result GameResult?

  ratingGains RatingGain[]

  @@unique([category,round,mode,whitePlayerId,blackPlayerId])

  @@index([category])
  @@index([round])
  @@index([mode])
  @@index([availableAt])
  @@index([whitePlayerId])
  @@index([blackPlayerId])
}


model TeamPairing {
  id Int @id @default(autoincrement())

  round Int

  teamAId Int
  teamBId Int

  teamA Team @relation("TeamA",fields: [teamAId],references: [id],onDelete: Cascade )

  teamB Team @relation("TeamB",fields: [teamBId],references: [id],onDelete: Cascade)

  availableAt DateTime

  createdAt DateTime @default(now())

  @@unique([round, teamAId, teamBId])

  @@index([round])
  @@index([teamAId])
  @@index([teamBId])
  @@index([availableAt])
}



model GameResult {
  id Int @id @default(autoincrement())

  round Int
  mode  GameMode

  whitePlayerId Int
  blackPlayerId Int

  whitePlayer Player @relation("WhitePlayerResults",fields: [whitePlayerId],references: [id],onDelete: Cascade)

  blackPlayer Player @relation("BlackPlayerResults",fields: [blackPlayerId],references: [id],onDelete: Cascade)

  whiteScore Float
  blackScore Float

  whiteRatingChange Int @default(0)
  blackRatingChange Int @default(0)

  category String

  approvalStatus ApprovalStatus @default(PENDING)

  approvedAt DateTime?

  pairingId Int? @unique

  pairing Pairing? @relation(fields: [pairingId],references: [id],onDelete: SetNull)

  date DateTime @default(now())

  @@index([round])
  @@index([mode])
  @@index([category])
  @@index([date])
  @@index([approvalStatus])
  @@index([whitePlayerId])
  @@index([blackPlayerId])
}


model RatingGain {
  id Int @id @default(autoincrement())

  playerId Int

  player Player @relation(fields: [playerId],references: [id],onDelete: Cascade)

  pairingId Int?

  pairing Pairing? @relation(fields: [pairingId],references: [id],onDelete: SetNull)

  mode GameMode

  amount Int

  reason String?

  createdAt DateTime @default(now())

  @@index([playerId])
  @@index([pairingId])
  @@index([mode])
  @@index([createdAt])
}



model PlayerRanking {
  id Int @id @default(autoincrement())

  playerId Int

  player Player @relation(fields: [playerId],references: [id],onDelete: Cascade)

  category String
  mode     GameMode

  rank Int

  totalPoints Float @default(0)
  totalRounds Int   @default(0)

  accuracy Float @default(0)

  tournamentId Int?

  tournament Tournament? @relation(fields: [tournamentId], references: [id],onDelete: Cascade)

  month Int?
  year  Int?

  createdAt DateTime @default(now())

  @@index([playerId])
  @@index([category])
  @@index([mode])
  @@index([rank])
  @@index([tournamentId])
  @@index([year, month])
}


model TeamRanking {
  id Int @id @default(autoincrement())

  teamId Int

  team Team @relation(fields: [teamId],references: [id], onDelete: Cascade)

  category String?
  mode     GameMode?

  rank Int

  totalPoints Float @default(0)
  ratingGain  Int   @default(0)

  month Int?
  year  Int?

  tournamentId Int?

  tournament Tournament? @relation(fields: [tournamentId],references: [id],onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([teamId])
  @@index([rank])
  @@index([category])
  @@index([mode])
  @@index([tournamentId])
  @@index([year, month])
}



model Tournament {
  id Int @id @default(autoincrement())

  name String

  category String?

  mode GameMode

  type ChampionshipType @default(TOURNAMENT)

  status TournamentStatus @default(DRAFT)

  championPlayerId Int? 
  championPlayer Player? @relation("TournamentChampion", fields: [championPlayerId], references: [id], onDelete: SetNull)

  championUsername String?

  championTitle String?

  startedAt  DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  playerRankings PlayerRanking[]

  teamRankings TeamRanking[]

  results TournamentResult[]

  @@index([mode])
  @@index([category])
  @@index([status])
  @@index([completedAt])
  @@index([championPlayerId])
}


model TournamentResult {
  id Int @id @default(autoincrement())

  tournamentId Int
  playerId     Int

  tournament Tournament @relation(fields: [tournamentId],references: [id],onDelete: Cascade )

  player Player @relation(fields: [playerId],references: [id],onDelete: Cascade)

  rank Int

  totalPoints Float @default(0)

  totalRounds Int @default(0)

  accuracy Float @default(0)

  ratingBefore Int @default(0)
  ratingAfter  Int @default(0)

  createdAt DateTime @default(now())

  @@unique([tournamentId, playerId])

  @@index([tournamentId])
  @@index([playerId])
  @@index([rank])
}


model BulletChampionship {
  id Int @id @default(autoincrement())

  name String

  status TournamentStatus @default(DRAFT)

  championPlayerId Int?
  championPlayer  Player? @relation("BulletChampion", fields: [championPlayerId], references: [id], onDelete: SetNull)

  championUsername String?

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players BulletChampionshipPlayer[]

  @@index([status])
  @@index([completedAt])
  @@index([championPlayerId])
}


model BulletChampionshipPlayer {
  id Int @id @default(autoincrement())

  championshipId Int
  playerId       Int

  championship BulletChampionship @relation(fields: [championshipId],references: [id],onDelete: Cascade)

  player Player @relation(fields: [playerId],references: [id],onDelete: Cascade )

  rank Int?

  totalPoints Float @default(0)

  totalRounds Int @default(0)

  accuracy Float @default(0)

  @@unique([championshipId, playerId])

  @@index([championshipId])
  @@index([playerId])
}



model ApprovalRequest {
  id Int @id @default(autoincrement())

  playerId Int?

  player Player? @relation(fields: [playerId],references: [id],onDelete: Cascade)

  type ApprovalType

  status ApprovalStatus @default(PENDING)

  data String

  reason String?

  adminId Int?
  admin   Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  reviewedAt DateTime?

  createdAt DateTime @default(now())

  @@index([playerId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}


model Notification {
  id Int @id @default(autoincrement())

  playerId Int?

  player Player? @relation(fields: [playerId],references: [id],onDelete: Cascade)

  type NotificationType

  title String

  message String

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([playerId])
  @@index([isRead])
  @@index([createdAt])
}

model Announcement {
  id Int @id @default(autoincrement())

  message String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}


model Admin {
  id Int @id @default(autoincrement())

  username     String @unique
  passwordHash String

  ipAddress String?

  approvalRequests ApprovalRequest[]

  status AdminStatus @default(ACTIVE)

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loginLogs AdminLoginLog[]

  @@index([ipAddress])
}


model AdminLoginLog {
  id Int @id @default(autoincrement())

  adminId Int

  admin Admin @relation(fields: [adminId],references: [id],onDelete: Cascade )

  ipAddress String

  successful Boolean @default(false)

  loginAt DateTime @default(now())

  @@index([adminId])
  @@index([ipAddress])
  @@index([loginAt])
}


model BlockedIP {
  id Int @id @default(autoincrement())

  ipAddress String @unique

  isBlocked Boolean @default(true)

  blockedAt DateTime @default(now())

  unblockedAt DateTime?

  @@index([isBlocked])
}
